# Visual Studio / VS Code local workspace state. These are per-machine editor
# files (open tabs, indexes, a local sqlite cache) — they were previously
# committed by the daily workflow's `git add .`, which now stages only the
# generated data files.
.vs/
.vscode/
*.suo
*.user

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Claude Code workspace state. launch.json here carries absolute paths to other
# local projects, so it is a personal convenience rather than repo config --
# AGENT-TEAM.md documents the dev-server configs a fresh clone needs.
.claude/
